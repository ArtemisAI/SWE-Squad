[Unit]
Description=SWE-Squad Fleet Orchestrator — Detect and Fix Systemic Issues
Documentation=https://github.com/linkedai/SWE-Squad
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
WorkingDirectory=/home/agent/SWE-Squad
EnvironmentFile=/home/agent/SWE-Squad/.env

# Run orchestrator in daemon mode with verbose logging
ExecStart=/usr/bin/python3 scripts/ops/swe_orchestrator.py --daemon --verbose

# Restart policy: on-failure with 10-second delay
Restart=on-failure
RestartSec=10

# Process management
KillMode=mixed
KillSignal=SIGTERM

# Resource limits (optional, adjust as needed)
MemoryMax=1G

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swe-orchestrator

[Install]
WantedBy=default.target
