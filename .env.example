# =============================================================================
# SWE-Squad — Environment Configuration
# Drop this file as `.env` in the project root (~/SWE-Squad/.env)
# The runner loads it automatically via python-dotenv on startup.
# =============================================================================

# -----------------------------------------------------------------------------
# Core — Kill Switch & Config
# -----------------------------------------------------------------------------
SWE_TEAM_ENABLED=true
SWE_TEAM_CONFIG=/home/agent/SWE-Squad/config/swe_team.yaml

# -----------------------------------------------------------------------------
# Team Identity — scopes tickets and GitHub issue assignment
# Each SWE team gets a unique ID and dedicated GitHub account
# -----------------------------------------------------------------------------
SWE_TEAM_ID=swe-squad-1
SWE_GITHUB_ACCOUNT=your_github_bot_account
SWE_GITHUB_REPO=owner/repo-name

# -----------------------------------------------------------------------------
# GitHub (gh CLI authentication)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:org
# Used for: issue creation, commenting, fetching assigned tickets
# -----------------------------------------------------------------------------
GH_TOKEN=your_github_pat_here

# -----------------------------------------------------------------------------
# Telegram Notifications
# Create a bot via @BotFather, get the chat ID via @userinfobot
# Used for: HIGH/CRITICAL alerts, HITL escalation, daily summaries
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# -----------------------------------------------------------------------------
# A2A Hub (inter-agent communication)
# Leave as localhost if running SWE-Squad standalone on this VM
# -----------------------------------------------------------------------------
A2A_HUB_URL=http://100.110.176.73:18790          # Tailscale hub (openclaw, gemini, llm_proxy)
A2A_HUB_HEALTHCHECK_URL=http://100.110.176.73:18790/health

# -----------------------------------------------------------------------------
# Anthropic / Claude (if invoking API directly rather than CLI)
# The runner uses the `claude` CLI by default — set this only if needed
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# Base LLM Proxy (shared by Claude/OpenAI-compatible workloads)
# -----------------------------------------------------------------------------
# BASE_LLM_API_URL=https://your-llm-proxy.example.com/v1
# BASE_LLM_API_KEY=your_llm_proxy_key
EXTRACTION_MODEL=gemini-2.5-flash-thinking      # proven working; gemini-3-flash returns empty
# GEMINI_CLI_PATH=/usr/bin/gemini               # override if gemini not on PATH

# -----------------------------------------------------------------------------
# Text-to-Speech (defaults to BASE_LLM_* when omitted)
# OpenAI-compatible /v1/audio/speech endpoint
# Used for: Telegram voice message generation
# -----------------------------------------------------------------------------
# TTS_API_URL=https://your-llm-proxy.example.com/v1
# TTS_API_KEY=your_llm_proxy_key
TTS_MODEL=kokoro

# -----------------------------------------------------------------------------
# Speech-to-Text (defaults to BASE_LLM_* when omitted)
# OpenAI-compatible /v1/audio/transcriptions endpoint
# Used for: Transcribing incoming Telegram voice messages
# -----------------------------------------------------------------------------
# STT_API_URL=https://your-llm-proxy.example.com/v1
# STT_API_KEY=your_llm_proxy_key
STT_MODEL=whisper-1

# -----------------------------------------------------------------------------
# Semantic Memory / Embeddings (defaults to BASE_LLM_* when omitted)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_API_URL=https://your-llm-proxy.example.com/v1
# EMBEDDING_API_KEY=your_llm_proxy_key

# -----------------------------------------------------------------------------
# Remote Worker Log Collection (SSH/rsync)
# Uses a scoped SSH config (config/ssh_workers.conf) with a dedicated key
# that only reaches explicitly listed worker nodes — never the primary.
# Get Tailscale IPs: tailscale status
# -----------------------------------------------------------------------------
# SWE_SSH_CONFIG=config/ssh_workers.conf
# SWE_REMOTE_NODES='[{"name":"linkedai-browser-1","ssh":"linkedai-browser-1","log_dir":"~/Projects/LinkedAi/logs"},{"name":"linkedai-browser-2","ssh":"linkedai-browser-2","log_dir":"~/Projects/LinkedAi/logs"},{"name":"linkedai-bot-2","ssh":"linkedai-bot-2","log_dir":"~/Projects/LinkedAi/logs"},{"name":"linkedai-hp-laptop","ssh":"linkedai-hp-laptop","log_dir":"~/Projects/LinkedAi/logs"}]'

# -----------------------------------------------------------------------------
# Supabase (optional — replaces JSON ticket store)
# Leave blank to use the default JSON file store
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_key
