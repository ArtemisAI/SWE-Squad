# =============================================================================
# SWE-Squad Memory Service — Environment Configuration
# Copy to .env and fill in values
# =============================================================================

# --- Worker Service ---
MEMORY_WORKER_HOST=127.0.0.1
MEMORY_WORKER_PORT=37777

# --- Multi-Tenant Scoping ---
SWE_TEAM_ID=default

# --- Authentication (required for network-exposed deployments) ---
MEMORY_API_KEY=

# --- Supabase (required for PostgreSQL backend) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- Chroma Vector DB (optional — Supabase pgvector is the default) ---
CLAUDE_MEM_CHROMA_MODE=disabled
# CLAUDE_MEM_CHROMA_HOST=localhost
# CLAUDE_MEM_CHROMA_PORT=8000

# --- Embedding Model ---
# Uses SWE-Squad's existing bge-m3 pipeline via BASE_LLM proxy
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
BASE_LLM_URL=http://localhost:8082/v1

# --- Logging ---
LOG_LEVEL=info
