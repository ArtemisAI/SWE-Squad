{
  "name": "@swe-squad/memory",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-mem integration for SWE-Squad — multi-tenant persistent memory service",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/build.js",
    "start": "node dist/server.js",
    "test": "tsx --test tests/**/*.test.ts",
    "migrate": "tsx src/migrate.ts",
    "worker:start": "bun run node_modules/claude-mem/plugin/scripts/worker-service.cjs start",
    "worker:stop": "bun run node_modules/claude-mem/plugin/scripts/worker-service.cjs stop"
  },
  "dependencies": {
    "claude-mem": "github:thedotmack/claude-mem#main",
    "express": "^4.18.2",
    "@supabase/supabase-js": "^2.45.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsx": "^4.20.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.0"
  }
}
